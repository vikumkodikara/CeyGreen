                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmerId\": \"{{farmerId}}\",\n  \"rating\": 5,\n  \"comment\": \"Effective treatment, saw improvement in 3 days.\"\n}"
            },
            "url": {
              "raw": "{{treatmentServiceUrl}}/treatments/1/rate",
              "host": [
                "{{treatmentServiceUrl}}"
              ],
              "path": [
                "treatments",
                "1",
                "rate"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Sales Analytics & Notifications (Student 6 - Kafka Consumer)",
      "item": [
        {
          "name": "Get Analytics Summary Dashboard",
          "request": {
            "method": "GET",
