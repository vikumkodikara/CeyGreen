              ],
              "path": [
                "treatments",
                "disease",
                "Tomato Early Blight"
              ]
            }
          }
        },
        {
          "name": "Get Treatment by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{treatmentServiceUrl}}/treatments/1",
              "host": [
                "{{treatmentServiceUrl}}"
