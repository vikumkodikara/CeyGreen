{
  "info": {
    "name": "CeyGreen Ecosystem - Complete Microservices Collection",
    "description": "Postman collection for all CeyGreen microservices including Disease Diagnosis, User Management, Treatment, IoT, Analytics, and Notifications with configured API keys and JWT Bearer tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "userServiceUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "diagnosisServiceUrl",
      "value": "http://localhost:8087",
      "type": "string"
    },
    {
      "key": "treatmentServiceUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "iotServiceUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "analyticsServiceUrl",
      "value": "http://localhost:8086",
      "type": "string"
    },
    {
      "key": "notificationServiceUrl",
      "value": "http://localhost:8088",
      "type": "string"
    },
    {
      "key": "ecommerceServiceUrl",
      "value": "http://localhost:8084",
      "type": "string"
    },
    {
      "key": "forumServiceUrl",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "ceygreen-dev-api-key",
      "type": "string"
    },
    {
      "key": "analyticsApiKey",
      "value": "ceygreen-secret-api-key-2026",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "farmerId",
      "value": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "type": "string"
    },
    {
      "key": "diagnosisId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. User Management (Student 2)",
      "item": [
        {
          "name": "Register Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('userId', json.id);",
                  "    pm.collectionVariables.set('farmerId', json.id);",
                  "    console.log('Saved userId:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kasun Perera\",\n  \"email\": \"farmer.kasun1787220611675@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"FARMER\",\n  \"phone\": \"+94771234567\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/users/register",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login (Issues JWT Access Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('userId', json.user.id);",
                  "    pm.collectionVariables.set('farmerId', json.user.id);",
                  "    console.log('Successfully saved accessToken and userId!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer.kasun@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/users/login",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{userServiceUrl}}/users/{{userId}}",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kasun Perera Updated\",\n  \"phone\": \"+94779876543\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/users/{{userId}}",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Get JWKS Public Key Set",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{userServiceUrl}}/oauth2/jwks",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "oauth2",
                "jwks"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Disease Diagnosis Service (Student 2 - Kafka Producer)",
      "item": [
        {
          "name": "Upload & Diagnose Leaf Image (Publishes to Kafka)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('diagnosisId', json.id);",
                  "    console.log('Diagnosis ID:', json.id);",
                  "    console.log('Predicted Disease:', json.predictedDisease);",
                  "    console.log('Confidence:', json.confidenceScore);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "cropType",
                  "value": "Tomato",
                  "type": "text"
                },
                {
                  "key": "farmerId",
                  "value": "{{farmerId}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{diagnosisServiceUrl}}/diagnoses",
              "host": [
                "{{diagnosisServiceUrl}}"
              ],
              "path": [
                "diagnoses"
              ]
            },
            "description": "Uploads a crop leaf image. Runs ONNX ResNet50V2 ML inference, saves record in MongoDB, and triggers DiagnosisEventPublisher to publish to 'diagnosis-events' topic on Kafka."
          }
        },
        {
          "name": "Get Diagnosis by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{diagnosisServiceUrl}}/diagnoses/{{diagnosisId}}",
              "host": [
                "{{diagnosisServiceUrl}}"
              ],
              "path": [
                "diagnoses",
                "{{diagnosisId}}"
              ]
            }
          }
        },
        {
          "name": "Get Diagnosis History for Farmer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{diagnosisServiceUrl}}/diagnoses/history/{{farmerId}}",
              "host": [
                "{{diagnosisServiceUrl}}"
              ],
              "path": [
                "diagnoses",
                "history",
                "{{farmerId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Diagnosis Record",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{diagnosisServiceUrl}}/diagnoses/{{diagnosisId}}",
              "host": [
                "{{diagnosisServiceUrl}}"
              ],
              "path": [
                "diagnoses",
                "{{diagnosisId}}"
              ]
            }
          }
        },
        {
          "name": "Health Check Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{diagnosisServiceUrl}}/actuator/health",
              "host": [
                "{{diagnosisServiceUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Treatment & Suggestion Service (Student 3)",
      "item": [
        {
          "name": "Get Treatment by Disease Name",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{treatmentServiceUrl}}/treatments/disease/Tomato Early Blight",
              "host": [
