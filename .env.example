# Copy to .env and adjust as needed. docker compose loads .env automatically.

# ─── Shared Secrets ───
SERVICE_API_KEY=ceygreen-dev-api-key
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_REQUESTS_PER_MIN=60
VITE_API_BASE_URL=http://localhost:8080/api


# ─── JWT Key Overrides (defaults work for local dev) ───
# JWT_PRIVATE_KEY_LOCATION=classpath:keys/dev-private.pem
# JWT_PUBLIC_KEY_LOCATION=classpath:keys/dev-public.pem

# ─── Database Credentials (defaults work for local docker compose) ───
# POSTGRES_PASSWORD=ceygreen

# ─── Teammate Service URLs (gateway uses these for routing) ───
# Defaults are set in docker-compose.yml as inter-container URLs.
# Override here only if running services outside Docker.
# IOT_SERVICE_URL=http://iot-service:8082
# TREATMENT_SERVICE_URL=http://treatment-service:8083
# ECOMMERCE_SERVICE_URL=http://ecommerce-service:8084
# FORUM_SERVICE_URL=http://forum-service:8085
# ANALYTICS_SERVICE_URL=http://analytics-service:8086

# ─── Firebase (Student 1 — IoT Service) ───
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
