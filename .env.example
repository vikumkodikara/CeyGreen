SERVICE_API_KEY=ceygreen-dev-api-key
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://16.192.168.12:3000,http://16.192.168.12
VITE_GEMINI_API_KEY=dummy
# IoT storage. false = RAM only (lost on restart). true = Firebase Realtime Database.
# ESP32 still POSTs to /api/iot/readings — Java writes to Firebase, not the board.
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=ceygreen-iot
FIREBASE_DATABASE_URL=https://ceygreen-iot-default-rtdb.firebaseio.com
# Put the service-account JSON at iot-service/config/firebase-service-account.json (gitignored).
FIREBASE_CREDENTIALS_FILE=./iot-service/config/firebase-service-account.json

# Grafana Greenhouse Health dashboard (http://localhost:3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
